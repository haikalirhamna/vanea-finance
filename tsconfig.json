{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "types": ["jest", "node"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["app", "src", "*.d.ts"]
}
